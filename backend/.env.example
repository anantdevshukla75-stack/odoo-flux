# Application
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions?schema=public

# Redis & Background Processing
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_smtp_user
SMTP_PASSWORD=test_smtp_password
EMAIL_FROM=Brightloop Software <billing@brightloopsoftware.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
